#!/bin/sh
cd /tmp/aeolus-capture || exit 1
tcpdump -i phy1-ap4 -p -n -U -s 128 -c 72817 -w 0.pcap 'ether host 7e:2a:ea:04:b1:8f' 2>0.err &
echo $! >0.pid
tcpdump -i eth0 -p -n -U -s 128 -c 72817 -w 1.pcap 'ether host 7e:2a:ea:04:b1:8f and vlan 10' 2>1.err &
echo $! >1.pid
sleep 60 &
echo $! >timer.pid
wait $!
for p in *.pid; do [ "$p" = timer.pid ] || kill "$(cat "$p")" 2>/dev/null; done
wait
: >ended
#!/bin/sh
cd /tmp/aeolus-capture || exit 1
tcpdump -i eth0 -p -n -U -s 262144 -c 32443 -w 0.pcap 'vlan 10' 2>0.err &
echo $! >0.pid
sleep 30 &
echo $! >timer.pid
wait $!
for p in *.pid; do [ "$p" = timer.pid ] || kill "$(cat "$p")" 2>/dev/null; done
wait
: >ended

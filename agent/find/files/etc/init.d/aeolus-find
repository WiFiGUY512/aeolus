#!/bin/sh /etc/rc.common
# Looks for an Aeolus manager by its name, while this AP has none, and joins
# it (0151). Its log: logread -e aeolus-find. To have none of it:
# /etc/init.d/aeolus-find disable

START=99
USE_PROCD=1

start_service() {
	# An AP with a manager is not looking for one.
	[ -z "$(uci -q get aeolus.agent.url)" ] || return 0
	# Nor is a system run from memory, an installer or an image on trial:
	# what it joined as would be gone at its next boot.
	/usr/sbin/aeolus-find from-memory && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/aeolus-find run
	procd_set_param stderr 1
	procd_close_instance
}
